# Server
PORT=3000
NODE_ENV=production
BASE_URL=http://localhost:3000

# Logging
LOG_LEVEL=info          # debug | info | warn | error
LOG_FILE_PATH=./logs    # Absolute or relative path for structured log files

# Security
MAX_FILE_SIZE_BYTES=52428800   # 50MB default
ALLOWED_EXTENSIONS=.txt,.html,.htm,.md,.markdown,.json,.pdf,.docx
ALLOWED_MIME_TYPES=text/plain,text/html,text/markdown,application/json,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Batch processing
BATCH_CONCURRENCY=5
BATCH_MAX_RETRIES=3

# Directories (for Docker volumes)
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output